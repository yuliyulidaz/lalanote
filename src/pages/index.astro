---
import '../styles/global.css';

const libraryUrl = `${import.meta.env.BASE_URL}encrypted/library.json`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="A private collection of English stories." />
    <title>The Girl in the Library</title>
  </head>
  <body data-library-url={libraryUrl}>
    <div class="grain" aria-hidden="true"></div>
    <main>
      <section class="gate" id="gate" aria-labelledby="site-title">
        <p class="eyebrow">A PRIVATE READING ROOM</p>
        <h1 id="site-title">The Girl<br />in the Library</h1>
        <div class="rule"><span>✦</span></div>
        <p class="invitation">The collection is kept behind a locked door.</p>

        <form id="unlock-form">
          <label for="password">Reading key</label>
          <div class="field-row">
            <input id="password" name="password" type="password" autocomplete="current-password" required autofocus />
            <button type="submit">Enter</button>
          </div>
          <p class="status" id="status" role="alert" aria-live="polite"></p>
        </form>
      </section>

      <div class="library-shell" id="library-shell" hidden>
        <header class="masthead">
          <button class="wordmark" type="button" data-show-library>The Girl in the Library</button>
          <nav class="top-nav" aria-label="Library navigation">
            <button type="button" data-show-library>Library</button>
            <button type="button" id="lock-button">Lock</button>
          </nav>
        </header>

        <section class="library-home" id="library-home" aria-labelledby="library-title">
          <div class="library-hero">
            <p class="eyebrow">THE PRIVATE COLLECTION</p>
            <h2 id="library-title">Choose a story.</h2>
            <p>Open any chapter, revisit any passage, and move freely between stories.</p>
          </div>

          <section class="last-place" id="last-place" aria-labelledby="last-place-label" hidden>
            <div>
              <p class="small-label" id="last-place-label">Last opened</p>
              <h3 id="last-book-title"></h3>
              <p id="last-chapter-title"></p>
            </div>
            <button class="outlined-button" id="resume-button" type="button">Return to chapter →</button>
          </section>

          <section class="shelves" aria-labelledby="shelves-title">
            <div class="section-heading">
              <h3 id="shelves-title">The shelves</h3>
              <p id="book-count"></p>
            </div>
            <div class="book-grid" id="book-grid"></div>
          </section>
        </section>

        <section class="book-detail" id="book-detail" aria-labelledby="detail-title" hidden>
          <button class="back-button" type="button" data-show-library>← Return to the shelves</button>
          <div class="detail-layout">
            <div class="detail-cover" id="detail-cover" aria-hidden="true"></div>
            <div class="detail-copy">
              <p class="eyebrow">FROM THE PRIVATE COLLECTION</p>
              <h2 id="detail-title"></h2>
              <p class="description" id="detail-description"></p>
              <div class="chapter-list" id="chapter-list" aria-label="Chapters"></div>
            </div>
          </div>
        </section>

        <article class="reader" id="reader" aria-labelledby="chapter-title" hidden>
          <div class="reader-floating-controls">
            <button class="back-button floating-back-button" id="show-chapters" type="button">← Chapter list</button>
            <div class="language-switch" id="language-switch" role="group" aria-label="Reading language" data-mode="english" hidden>
              <button type="button" id="english-mode" aria-label="English only" aria-pressed="true" title="English only">E</button>
              <button type="button" id="korean-mode" aria-label="English and Korean" aria-pressed="false" title="English + 한국어">K</button>
            </div>
          </div>
          <div class="reader-header" aria-hidden="true"></div>
          <p class="chapter-count" id="chapter-count"></p>
          <h2 id="chapter-title"></h2>
          <p class="chapter-translation-title" id="chapter-translation-title" lang="ko" hidden></p>
          <div class="chapter-body" id="chapter-body" lang="en"></div>
          <nav class="reader-navigation" aria-label="Chapter navigation">
            <button class="nav-button" id="previous" type="button">← Previous</button>
            <button class="nav-button" id="all-chapters" type="button">All chapters</button>
            <button class="nav-button" id="next" type="button">Next →</button>
          </nav>

          <section class="reading-room" id="reading-room" aria-labelledby="reading-room-title" hidden>
            <button class="room-toggle" id="room-toggle" type="button" aria-expanded="false" aria-controls="room-panel">
              <span class="room-heading">
                <span class="small-label">THE READING ROOM</span>
                <strong id="reading-room-title">Reader reactions</strong>
              </span>
              <span class="room-toggle-meta">
                <span id="reaction-count"></span>
                <span id="room-toggle-label">Open</span>
              </span>
            </button>
            <div class="room-panel" id="room-panel" hidden>
              <div class="room-toolbar">
                <p>Top reactions</p>
                <p>Archived with this chapter</p>
              </div>
              <div class="reaction-list" id="reaction-list"></div>
              <button class="show-all-reactions" id="show-all-reactions" type="button" hidden></button>
            </div>
          </section>
        </article>
      </div>
    </main>

    <script>
      type ReaderProfile = {
        id: string;
        username: string;
        symbol: string;
        color: string;
        voice?: string;
      };
      type Reaction = {
        id: string;
        readerId: string;
        posted: string;
        likes: number;
        text: string;
        translation?: string;
        replies?: Reaction[];
      };
      type ReactionSet = { comments: Reaction[] };
      type Chapter = { title: string; html: string; reactions?: ReactionSet | null; korean?: { title?: string; paragraphs: string[] } };
      type ReadingMode = 'english' | 'bilingual';
      type Book = {
        id: string;
        title: string;
        kind: string;
        description: string;
        color: string;
        symbol: string;
        readers?: ReaderProfile[];
        chapters: Chapter[];
      };
      type Library = { title: string; books: Book[] };
      type Payload = {
        kdf: { iterations: number; salt: string };
        cipher: { iv: string; tagLength: number };
        data: string;
      };
      type ReadingPlace = { bookId: string; chapterIndex: number };

      const STORAGE_KEY = 'tgilt:last-place';
      const gate = document.querySelector<HTMLElement>('#gate')!;
      const shell = document.querySelector<HTMLElement>('#library-shell')!;
      const libraryHome = document.querySelector<HTMLElement>('#library-home')!;
      const bookDetail = document.querySelector<HTMLElement>('#book-detail')!;
      const reader = document.querySelector<HTMLElement>('#reader')!;
      const form = document.querySelector<HTMLFormElement>('#unlock-form')!;
      const passwordInput = document.querySelector<HTMLInputElement>('#password')!;
      const status = document.querySelector<HTMLElement>('#status')!;
      const bookGrid = document.querySelector<HTMLElement>('#book-grid')!;
      const chapterList = document.querySelector<HTMLElement>('#chapter-list')!;
      const chapterTitle = document.querySelector<HTMLElement>('#chapter-title')!;
      const chapterBody = document.querySelector<HTMLElement>('#chapter-body')!;
      const chapterCount = document.querySelector<HTMLElement>('#chapter-count')!;
      const languageSwitch = document.querySelector<HTMLElement>('#language-switch')!;
      const englishMode = document.querySelector<HTMLButtonElement>('#english-mode')!;
      const koreanMode = document.querySelector<HTMLButtonElement>('#korean-mode')!;
      const translatedTitle = document.querySelector<HTMLElement>('#chapter-translation-title')!;
      const previous = document.querySelector<HTMLButtonElement>('#previous')!;
      const next = document.querySelector<HTMLButtonElement>('#next')!;
      const readingRoom = document.querySelector<HTMLElement>('#reading-room')!;
      const roomToggle = document.querySelector<HTMLButtonElement>('#room-toggle')!;
      const roomPanel = document.querySelector<HTMLElement>('#room-panel')!;
      const roomToggleLabel = document.querySelector<HTMLElement>('#room-toggle-label')!;
      const reactionList = document.querySelector<HTMLElement>('#reaction-list')!;
      const showAllReactions = document.querySelector<HTMLButtonElement>('#show-all-reactions')!;
      const initialReactionCount = 5;
      let library: Library | null = null;
      let currentBookIndex = 0;
      let currentChapterIndex = 0;
      let englishParagraphs: HTMLElement[] = [];
      let koreanParagraphs: HTMLElement[] = [];

      const fromBase64 = (value: string) => Uint8Array.from(atob(value), (character) => character.charCodeAt(0));

      function roman(number: number) {
        const values: Array<[number, string]> = [[10, 'X'], [9, 'IX'], [5, 'V'], [4, 'IV'], [1, 'I']];
        let result = '';
        for (const [value, numeral] of values) {
          while (number >= value) {
            result += numeral;
            number -= value;
          }
        }
        return result;
      }

      function makeCover(book: Book, index: number) {
        const cover = document.createElement('div');
        cover.className = 'book-cover';
        cover.style.setProperty('--cover-color', book.color);
        cover.innerHTML = `
          <span class="cover-frame"></span>
          <span class="cover-content">
            <span class="cover-series">Private Library · No. ${roman(index + 1)}</span>
            <span class="cover-symbol"></span>
            <span class="cover-title"></span>
            <span class="cover-kind"></span>
          </span>`;
        cover.querySelector<HTMLElement>('.cover-symbol')!.textContent = book.symbol;
        cover.querySelector<HTMLElement>('.cover-title')!.textContent = book.title;
        cover.querySelector<HTMLElement>('.cover-kind')!.textContent = book.kind;
        return cover;
      }

      async function decrypt(payload: Payload, password: string): Promise<Library> {
        const material = await crypto.subtle.importKey(
          'raw',
          new TextEncoder().encode(password),
          'PBKDF2',
          false,
          ['deriveKey'],
        );
        const key = await crypto.subtle.deriveKey(
          { name: 'PBKDF2', hash: 'SHA-256', salt: fromBase64(payload.kdf.salt), iterations: payload.kdf.iterations },
          material,
          { name: 'AES-GCM', length: 256 },
          false,
          ['decrypt'],
        );
        const plaintext = await crypto.subtle.decrypt(
          { name: 'AES-GCM', iv: fromBase64(payload.cipher.iv), tagLength: payload.cipher.tagLength },
          key,
          fromBase64(payload.data),
        );
        return JSON.parse(new TextDecoder().decode(plaintext));
      }

      function readLastPlace(): ReadingPlace | null {
        try {
          return JSON.parse(localStorage.getItem(STORAGE_KEY) || 'null');
        } catch {
          return null;
        }
      }

      function findBook(bookId: string) {
        return library?.books.findIndex((book) => book.id === bookId) ?? -1;
      }

      function formatLikes(likes: number) {
        if (likes < 1000) return String(likes);
        const value = likes / 1000;
        return `${(value >= 10 ? value.toFixed(0) : value.toFixed(1)).replace('.0', '')}k`;
      }

      function countReactions(comments: Reaction[]): number {
        return comments.reduce((total, comment) => total + 1 + countReactions(comment.replies || []), 0);
      }

      function findReader(book: Book, readerId: string): ReaderProfile {
        return book.readers?.find((readerProfile) => readerProfile.id === readerId) || {
          id: readerId,
          username: readerId,
          symbol: '•',
          color: '#545955',
        };
      }

      function makeReaction(book: Book, reaction: Reaction, isReply = false) {
        const profile = findReader(book, reaction.readerId);
        const article = document.createElement('article');
        article.className = `reaction-card${isReply ? ' reaction-reply' : ''}`;

        const avatar = document.createElement('span');
        avatar.className = 'reader-avatar';
        avatar.style.setProperty('--avatar-color', profile.color);
        avatar.textContent = profile.symbol;
        avatar.setAttribute('role', 'img');
        avatar.setAttribute('aria-label', `${profile.username} profile icon`);
        if (profile.voice) avatar.title = profile.voice;

        const content = document.createElement('div');
        content.className = 'reaction-content';
        const header = document.createElement('header');
        header.className = 'reaction-header';
        const author = document.createElement('strong');
        author.textContent = profile.username;
        const posted = document.createElement('span');
        posted.textContent = `· ${reaction.posted}`;
        header.append(author, posted);

        const body = document.createElement('p');
        body.className = 'reaction-text';
        body.textContent = reaction.text;

        const actions = document.createElement('div');
        actions.className = 'reaction-actions';
        const likes = document.createElement('span');
        likes.className = 'reaction-likes';
        likes.textContent = `♡ ${formatLikes(reaction.likes)}`;
        actions.append(likes);

        let translation: HTMLParagraphElement | null = null;
        if (reaction.translation) {
          translation = document.createElement('p');
          translation.className = 'reaction-translation';
          translation.textContent = reaction.translation;
          translation.hidden = true;
          const translateButton = document.createElement('button');
          translateButton.className = 'reaction-action';
          translateButton.type = 'button';
          translateButton.textContent = 'Translate';
          translateButton.addEventListener('click', () => {
            const willShow = translation!.hidden;
            translation!.hidden = !willShow;
            translateButton.textContent = willShow ? 'Hide translation' : 'Translate';
          });
          actions.append(translateButton);
        }

        content.append(header, body, actions);
        if (translation) content.append(translation);

        const replies = reaction.replies || [];
        if (replies.length) {
          const replyButton = document.createElement('button');
          replyButton.className = 'reply-toggle';
          replyButton.type = 'button';
          replyButton.textContent = `View ${replies.length} ${replies.length === 1 ? 'reply' : 'replies'}`;
          replyButton.setAttribute('aria-expanded', 'false');
          const replyList = document.createElement('div');
          replyList.className = 'reply-list';
          replyList.hidden = true;
          replies.forEach((reply) => replyList.append(makeReaction(book, reply, true)));
          replyButton.addEventListener('click', () => {
            const willShow = replyList.hidden;
            replyList.hidden = !willShow;
            replyButton.setAttribute('aria-expanded', String(willShow));
            replyButton.textContent = willShow
              ? `Hide ${replies.length === 1 ? 'reply' : 'replies'}`
              : `View ${replies.length} ${replies.length === 1 ? 'reply' : 'replies'}`;
          });
          content.append(replyButton, replyList);
        }

        article.append(avatar, content);
        return article;
      }

      function renderReactions(book: Book, chapter: Chapter) {
        const comments = chapter.reactions?.comments || [];
        reactionList.replaceChildren();
        roomPanel.hidden = true;
        roomToggle.setAttribute('aria-expanded', 'false');
        roomToggleLabel.textContent = 'Open';

        if (!comments.length) {
          readingRoom.hidden = true;
          return;
        }

        document.querySelector('#reaction-count')!.textContent = `${countReactions(comments)} reactions`;
        comments.forEach((reaction, index) => {
          const card = makeReaction(book, reaction);
          if (index >= initialReactionCount) {
            card.hidden = true;
            card.dataset.moreReaction = '';
          }
          reactionList.append(card);
        });

        showAllReactions.hidden = comments.length <= initialReactionCount;
        showAllReactions.textContent = `Show all ${comments.length} top comments`;
        showAllReactions.onclick = () => {
          reactionList.querySelectorAll<HTMLElement>('[data-more-reaction]').forEach((card) => { card.hidden = false; });
          showAllReactions.hidden = true;
        };
        readingRoom.hidden = false;
      }

      function showOnly(section: HTMLElement) {
        [libraryHome, bookDetail, reader].forEach((candidate) => { candidate.hidden = candidate !== section; });
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }

      function renderLibrary() {
        if (!library) return;
        bookGrid.replaceChildren();
        document.querySelector('#book-count')!.textContent = `${library.books.length} ${library.books.length === 1 ? 'novel' : 'novels'}`;

        library.books.forEach((book, index) => {
          const button = document.createElement('button');
          button.className = 'book-choice';
          button.type = 'button';
          button.append(makeCover(book, index));
          const title = document.createElement('span');
          title.className = 'book-caption';
          title.textContent = book.title;
          const chapters = document.createElement('span');
          chapters.className = 'book-chapters';
          chapters.textContent = `${book.chapters.length} ${book.chapters.length === 1 ? 'chapter' : 'chapters'}`;
          button.append(title, chapters);
          button.addEventListener('click', () => showBook(index));
          bookGrid.append(button);
        });

        const lastPlace = readLastPlace();
        const lastPlacePanel = document.querySelector<HTMLElement>('#last-place')!;
        const lastBookIndex = lastPlace ? findBook(lastPlace.bookId) : -1;
        const lastBook = lastBookIndex >= 0 ? library.books[lastBookIndex] : null;
        const lastChapter = lastBook && lastPlace ? lastBook.chapters[lastPlace.chapterIndex] : null;

        if (lastBook && lastChapter && lastPlace) {
          document.querySelector('#last-book-title')!.textContent = lastBook.title;
          document.querySelector('#last-chapter-title')!.textContent = `Chapter ${lastPlace.chapterIndex + 1} · ${lastChapter.title}`;
          const resumeButton = document.querySelector<HTMLButtonElement>('#resume-button')!;
          resumeButton.onclick = () => showChapter(lastBookIndex, lastPlace.chapterIndex);
          lastPlacePanel.hidden = false;
        } else {
          lastPlacePanel.hidden = true;
        }
      }

      function showLibrary() {
        renderLibrary();
        showOnly(libraryHome);
      }

      function showBook(index: number) {
        if (!library) return;
        currentBookIndex = index;
        const book = library.books[index];
        const coverContainer = document.querySelector<HTMLElement>('#detail-cover')!;
        coverContainer.replaceChildren(makeCover(book, index));
        document.querySelector('#detail-title')!.textContent = book.title;
        document.querySelector('#detail-description')!.textContent = book.description;
        chapterList.replaceChildren();

        const lastPlace = readLastPlace();
        book.chapters.forEach((chapter, chapterIndex) => {
          const button = document.createElement('button');
          button.className = 'chapter-row';
          button.type = 'button';
          const number = document.createElement('span');
          number.className = 'chapter-number';
          number.textContent = String(chapterIndex + 1).padStart(2, '0');
          const name = document.createElement('span');
          name.className = 'chapter-name';
          name.textContent = chapter.title;
          button.append(number, name);
          if (lastPlace?.bookId === book.id && lastPlace.chapterIndex === chapterIndex) {
            const marker = document.createElement('span');
            marker.className = 'last-opened-marker';
            marker.textContent = 'Last opened';
            button.append(marker);
          }
          button.addEventListener('click', () => showChapter(index, chapterIndex));
          // Reverse only the visible list; retain original indexes for navigation and memory.
          chapterList.prepend(button);
        });
        showOnly(bookDetail);
      }

      function setReadingMode(mode: ReadingMode, preservePosition = true) {
        const bilingual = mode === 'bilingual' && !koreanMode.disabled;
        let anchor: { element: HTMLElement; top: number } | null = null;
        if (preservePosition && !reader.hidden) {
          const readingLine = document.querySelector('#show-chapters')!.getBoundingClientRect().bottom + 24;
          for (let index = 0; index < englishParagraphs.length; index++) {
            const element = englishParagraphs[index];
            const rect = element.getBoundingClientRect();
            const translation = koreanParagraphs[index];
            const end = translation && !translation.hidden ? translation.getBoundingClientRect().bottom : rect.bottom;
            if (end > readingLine) {
              // If reading a translation, return to its English paragraph, below the controls.
              if (rect.top <= readingLine) anchor = { element, top: rect.bottom <= readingLine ? readingLine : rect.top };
              break;
            }
          }
        }
        chapterBody.dataset.readingMode = bilingual ? 'bilingual' : 'english';
        languageSwitch.dataset.mode = bilingual ? 'bilingual' : 'english';
        englishMode.setAttribute('aria-pressed', String(!bilingual));
        koreanMode.setAttribute('aria-pressed', String(bilingual));
        koreanParagraphs.forEach((paragraph) => { paragraph.hidden = !bilingual; });
        translatedTitle.hidden = !bilingual || !translatedTitle.textContent;
        if (anchor) window.scrollBy({ top: anchor.element.getBoundingClientRect().top - anchor.top, behavior: 'auto' });
      }

      function prepareReadingLanguage(chapter: Chapter) {
        englishParagraphs = Array.from(chapterBody.querySelectorAll<HTMLElement>('p'));
        koreanParagraphs = [];
        const translations = chapter.korean?.paragraphs;
        const available = Array.isArray(translations) && translations.length === englishParagraphs.length &&
          translations.length > 0 && translations.every((text) => typeof text === 'string' && text.trim());
        languageSwitch.hidden = !available;
        koreanMode.disabled = !available;
        translatedTitle.textContent = available ? chapter.korean?.title || '' : '';
        if (available) {
          englishParagraphs.forEach((paragraph, index) => {
            paragraph.classList.add('english-paragraph');
            paragraph.dataset.paragraphIndex = String(index);
            const translation = document.createElement('p');
            translation.className = 'chapter-translation';
            translation.lang = 'ko';
            translation.hidden = true;
            translation.textContent = translations![index];
            paragraph.after(translation);
            koreanParagraphs.push(translation);
          });
        }
        setReadingMode('english', false);
      }

      function showChapter(bookIndex: number, chapterIndex: number) {
        if (!library) return;
        currentBookIndex = bookIndex;
        currentChapterIndex = chapterIndex;
        const book = library.books[bookIndex];
        const chapter = book.chapters[chapterIndex];
        chapterCount.textContent = `CHAPTER ${chapterIndex + 1} OF ${book.chapters.length}`;
        chapterTitle.textContent = chapter.title;
        chapterBody.innerHTML = chapter.html;
        prepareReadingLanguage(chapter);
        previous.disabled = chapterIndex === 0;
        next.disabled = chapterIndex === book.chapters.length - 1;
        renderReactions(book, chapter);
        localStorage.setItem(STORAGE_KEY, JSON.stringify({ bookId: book.id, chapterIndex }));
        showOnly(reader);
      }

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        status.textContent = 'Opening the door…';
        form.querySelector('button')!.setAttribute('disabled', '');
        try {
          const dataUrl = new URL(document.body.dataset.libraryUrl!, window.location.href);
          dataUrl.searchParams.set('fresh', Date.now().toString());
          const response = await fetch(dataUrl, { cache: 'no-store' });
          if (!response.ok) throw new Error('Library data is unavailable.');
          const decrypted = await decrypt(await response.json(), passwordInput.value);
          if (!Array.isArray(decrypted.books)) throw new Error('Library data is outdated.');
          library = decrypted;
          passwordInput.value = '';
          gate.hidden = true;
          shell.hidden = false;
          showLibrary();
        } catch {
          status.textContent = 'That key does not open this door.';
          passwordInput.select();
        } finally {
          form.querySelector('button')!.removeAttribute('disabled');
        }
      });

      document.querySelectorAll('[data-show-library]').forEach((button) => button.addEventListener('click', showLibrary));
      document.querySelector('#show-chapters')!.addEventListener('click', () => showBook(currentBookIndex));
      document.querySelector('#all-chapters')!.addEventListener('click', () => showBook(currentBookIndex));
      englishMode.addEventListener('click', () => setReadingMode('english'));
      koreanMode.addEventListener('click', () => setReadingMode('bilingual'));
      previous.addEventListener('click', () => showChapter(currentBookIndex, currentChapterIndex - 1));
      next.addEventListener('click', () => showChapter(currentBookIndex, currentChapterIndex + 1));
      roomToggle.addEventListener('click', () => {
        const willOpen = roomPanel.hidden;
        roomPanel.hidden = !willOpen;
        roomToggle.setAttribute('aria-expanded', String(willOpen));
        roomToggleLabel.textContent = willOpen ? 'Close' : 'Open';
      });
      document.querySelector('#lock-button')!.addEventListener('click', () => {
        library = null;
        bookGrid.replaceChildren();
        chapterList.replaceChildren();
        chapterBody.replaceChildren();
        englishParagraphs = [];
        koreanParagraphs = [];
        translatedTitle.textContent = '';
        translatedTitle.hidden = true;
        languageSwitch.hidden = true;
        reactionList.replaceChildren();
        readingRoom.hidden = true;
        shell.hidden = true;
        gate.hidden = false;
        status.textContent = '';
        passwordInput.focus();
      });
    </script>
  </body>
</html>
